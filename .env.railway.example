# Скопируйте в Railway → Service → Variables
# PostgreSQL: добавьте плагин и привяжите к сервису (Railway создаст DATABASE_URL)

APP_NAME=AudioDrive
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:СГЕНЕРИРУЙТЕ_php_artisan_key:generate_--show
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stderr
LOG_LEVEL=error

# Достаточно DB_CONNECTION + DATABASE_URL от плагина Postgres:
DB_CONNECTION=pgsql
# DB_URL=${{Postgres.DATABASE_URL}}  — опционально, Laravel читает и DATABASE_URL

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

RAILPACK_PHP_EXTENSIONS=gd,pdo_pgsql
DB_SSLMODE=require

# Миграции и сид (идемпотентный) — scripts/predeploy.sh в railway.toml
