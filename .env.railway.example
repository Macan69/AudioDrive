# Скопируйте переменные в Railway → Service → Variables
# Подключите PostgreSQL и привяжите DATABASE_URL к сервису приложения

APP_NAME=AudioDrive
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:СГЕНЕРИРУЙТЕ_ЛОКАЛЬНО_php_artisan_key:generate_--show
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Расширения PHP (gd — фото товаров, pdo_pgsql — PostgreSQL)
RAILPACK_PHP_EXTENSIONS=gd,pdo_pgsql

# После первого успешного деплоя включите, чтобы не запускать migrate/seed при каждом билде:
# RAILPACK_SKIP_MIGRATIONS=true
